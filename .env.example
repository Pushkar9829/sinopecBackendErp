PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sinopec
# Render/Atlas can also use MONGODB_URI instead of MONGO_URI
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Exact browser origins allowed to call the API with cookies (comma separated).
# Any http://localhost:* is also allowed while NODE_ENV is not production.
# The Vercel frontend proxies /api same-origin, so it does not need to be listed.
CLIENT_ORIGIN=http://localhost:5173,https://sinopecerpfrontend.vercel.app
# Only used to create the first Super Admin on an empty database.
# Pick your own strong password; never deploy this example value.
SUPERADMIN_USERNAME=owner
SUPERADMIN_PASSWORD=
NODE_ENV=development
# Auth cookies are SameSite=Lax (CSRF-safe). Set to "none" only if a browser
# app on a different site must call this API directly.
# COOKIE_SAMESITE=lax
# Delete audit log rows older than this many days (unset = keep forever).
# AUDIT_RETENTION_DAYS=730
# Plant clock for due dates and dated lot names (default India).
# BUSINESS_UTC_OFFSET=+05:30
# Operators may edit/delete their own register entries for this many hours.
# OPERATOR_EDIT_HOURS=24
# How often open orders' tasks are re-synced to repair failed syncs (0 = off).
# TASK_RECONCILE_MINUTES=15
# Proxy hops in front of the API (Render = 1). Used for client IPs in rate limits and audit logs.
TRUST_PROXY_HOPS=1

# `npm run seed` WIPES orders, customers, inventory, registers and tasks, then
# loads demo data with demo users (password Demo@1234). It only runs against a
# localhost MONGO_URI, never with NODE_ENV=production, and only with:
# ALLOW_DESTRUCTIVE_SEED=1

# Optional S3 media (when set, uploads go to S3; CloudFront used for public URLs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
# or S3_BUCKET=
CLOUDFRONT_DOMAIN=
# or S3_PUBLIC_URL=

# Draft orders (WhatsApp / Gmail intake). Keys and tokens typed on the
# Draft order setup screen are stored encrypted with this key. Set it to a
# long random string and keep it: changing it means re-entering those keys.
# When unset, a key derived from JWT_ACCESS_SECRET is used.
# INTAKE_SECRET_KEY=
# Tests and local fakes only: point the readers at a local server instead of
# the real services.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# ANTHROPIC_API_BASE=
# WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v21.0

# Set when the network refuses Atlas (mongodb+srv) lookups: querySrv ECONNREFUSED.
# DNS_SERVERS=8.8.8.8,1.1.1.1
# On EC2 with an IAM role for the bucket, leave the two AWS keys empty and set:
# AWS_USE_INSTANCE_ROLE=1
